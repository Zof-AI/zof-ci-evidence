{
  "name": "@zof-ai/ci-evidence",
  "version": "0.1.1",
  "description": "Bounded offline CI test and analysis evidence normalization",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zof-ci-evidence": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zof-AI/zof-ci-evidence.git"
  },
  "homepage": "https://github.com/Zof-AI/zof-ci-evidence#readme",
  "bugs": {
    "url": "https://github.com/Zof-AI/zof-ci-evidence/issues"
  },
  "keywords": [
    "verification",
    "testing",
    "zof"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:package": "node tests/package.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@zof-ai/evidence-spec": "0.1.1",
    "saxes": "6.0.0"
  }
}
